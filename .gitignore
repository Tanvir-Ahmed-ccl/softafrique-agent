# Build output
/build/

# Local dev scratch
*.tmp
*.log

# Credentials must never be committed. The real files live in ProgramData on
# customer devices, but a developer machine or a CI runner can produce them in
# the working tree too.
credentials.dat
repo.password
config.yaml
remote.json
status.json

# Rendering installer/config.yaml.template with the MSI's own Windows defaults
# on a macOS or Linux box writes files whose names are literal Windows paths.
C:\*

# OS noise
.DS_Store
Thumbs.db
