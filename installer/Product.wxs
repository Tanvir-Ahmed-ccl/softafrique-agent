<?xml version="1.0" encoding="utf-8"?>
<!--
  Softafrique Backup Agent, WiX v5 (toolset-only: WixToolset.UI and
  WixToolset.Util, no v3 compatibility layer).

  Build:
    wix build installer/Product.wxs -arch x64 \
      -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext \
      -bindpath build/bin/ -o SoftafriqueBackupAgent.msi

  Deploy:
    msiexec /i SoftafriqueBackupAgent.msi /qn BACKUPPATH="D:\CustomerData"
    msiexec /i SoftafriqueBackupAgent.msi /qn TESTINSTALL=1   (CI smoke test)

  Design decisions, and the finding each one answers:

  * The agent runs as a Windows service as LocalSystem, because it has to back
    up when nobody is signed in. The SCM starts the exe with no arguments, which
    is why `agent` with no arguments means service mode.

  * State lives in %ProgramData%\SoftafriqueBackupAgent, not beside the exe.
    The credentials blob is DPAPI-sealed, but DPAPI only stops *other users*:
    anything running as SYSTEM or an administrator can still decrypt it. The
    thing that actually protects the customer's key is that directory's ACL,
    which this package sets explicitly rather than inheriting whatever
    %ProgramData% happens to allow.

  * The enrollment token is never an MSI property and never appears on a command
    line. The RMM writes it to a file with a tight ACL, passes the *path* as
    ENROLLTOKENFILE, and the agent deletes the file once the token is consumed.
    An MSI property would be written to the MSI log; a command line would be
    readable from the process table by every process on the machine.

  * The pilot is unsigned. Signing is a separate gate, documented in
    docs/OPERATIONS.md.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Softafrique Backup Agent"
           Manufacturer="Softafrique"
           Version="0.2.0.0"
           UpgradeCode="6C7A1F52-9E4B-4E2C-9C1F-2D8A5B7E0F34"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Encrypted, append-only backups to backup.softafrique.net" />

    <!-- A major upgrade replaces the binaries but leaves the sealed credentials
         in ProgramData alone, so a patch never leaves a working device
         unenrolled and unprotected. The new version reads the existing blob. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of the Softafrique Backup Agent is already installed. Remove it first." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Softafrique Backup Agent" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="SoftafriqueBackupAgent" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentExe" Guid="1E4C2A80-9B3D-4F51-8A67-2C0D9E5B7A11">
        <File Id="AgentExeFile"
              Name="SoftafriqueBackupAgent.exe"
              Source="!(bindpath.bin)\SoftafriqueBackupAgent.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="ResticExe" Guid="2F5D3B91-0C4E-4A62-9B78-3D1E0F6C8B22">
        <File Id="ResticExeFile"
              Name="restic.exe"
              Source="!(bindpath.bin)\restic.exe"
              KeyPath="yes" />
      </Component>

      <!-- The path validation helper, kept as its own component so a technician
           can also run it by hand to test a candidate folder. -->
      <Component Id="ValidatePathExe" Guid="3A6E4CA2-1D5F-4B73-8C89-4E2F1A7D9C33">
        <File Id="ValidatePathExeFile"
              Name="validatepath.exe"
              Source="!(bindpath.bin)\validatepath.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Softafrique Backup Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="DataFolderAcl" />
      <ComponentRef Id="DataFolderRegistry" />
      <ComponentRef Id="ConfigFile" />
    </Feature>

    <!-- ================= service ================= -->
    <Component Id="AgentService" Guid="4B7F5DB5-2E60-4C84-9D90-5F3A2B8EAD44" Directory="INSTALLFOLDER">
      <ServiceInstall Id="AgentServiceInstall"
                      Name="SoftafriqueBackupAgent"
                      DisplayName="Softafrique Backup Agent"
                      Description="Backs up customer folders to backup.softafrique.net. Append-only: it cannot delete snapshots."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="none"
                            RestartServiceDelayInSeconds="60"
                            ResetPeriodInDays="1" />
      </ServiceInstall>

      <!-- Start is deliberately not set. InstallServices would start the
           service before the RMM script has enrolled the device, and the first
           scheduled run would then fail with "not enrolled". The RMM script
           starts the service itself once enrollment has succeeded, and the
           token-file path starts it from the InstallExecuteSequence below. -->
      <ServiceControl Id="AgentServiceControl"
                      Name="SoftafriqueBackupAgent"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />

      <!-- Delayed auto-start. A backup agent that competes with everything else
           in the first seconds after boot makes the boot slower for no benefit;
           it only needs to be up within a minute or so. ServiceInstall has no
           attribute for this, so the value the SCM reads is written directly,
           under the service's own key rather than the app key above. -->
      <RegistryValue Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\SoftafriqueBackupAgent"
                     Name="DelayedAutoStart"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- ============== data directory and its ACL ============== -->
    <!--
      SYSTEM and Administrators only, inheritance switched off.

      An earlier draft granted Users read access here, on the theory that a
      monitoring agent could then read status.json. That does not work: a
      non-inheritable ACE on a directory applies to the directory itself, so
      Users could list the folder but not open anything in it, while the
      credentials blob sat in the same tree the moment before. The only
      supported way to build a DACL from Go is to hand-assemble the ACL buffer,
      which is not a risk worth taking in a backup agent, so the honest
      arrangement is a locked directory and an elevated reader.

      Consequence for monitoring: the Tactical RMM health check runs as SYSTEM
      and is unaffected. A third-party monitor that runs as an ordinary user
      cannot read status.json and must be given elevation, or an administrator
      can copy the file out. See docs/OPERATIONS.md.
    -->
    <Component Id="DataFolderAcl" Guid="5C8A6EC4-3F71-4D95-8EA1-6A4B3C9FBE55" Directory="DATAFOLDER">
      <!-- The folder is the keypath, and that is the whole point: PermissionEx
           lands in the LockPermissions table, which Windows Installer only
           applies to a component keypath'd on a file or directory. -->
      <CreateFolder KeyPath="yes">
        <util:PermissionEx User="SYSTEM" GenericAll="yes" Inheritable="yes" />
        <util:PermissionEx User="Administrators" GenericAll="yes" Inheritable="yes" />
      </CreateFolder>
    </Component>

    <!-- Kept as its own component rather than nested in the CreateFolder above.
         In v5 RegistryKey is a child of Component, and sharing a component with
         the folder would have meant the registry value won the keypath, which
         silently stops the DACL above from being applied at all. -->
    <Component Id="DataFolderRegistry" Guid="5C8A6EC4-3F71-4D95-8EA1-6A4B3C9FBE56" Directory="DATAFOLDER">
      <util:RegistryKey Root="HKLM" Key="SOFTWARE\Softafrique\BackupAgent">
        <RegistryValue Name="DataDir" Type="string" Value="[DATAFOLDER]" KeyPath="yes" />
      </util:RegistryKey>
    </Component>

    <!-- ================= configuration ================= -->
    <!--
      NeverOverwrite: a repair or an upgrade must not reset a config that a
      technician edited on site, in particular a BACKUPPATH that was corrected
      from what the RMM asked for. The template's placeholders are filled from
      the properties below, so the installed file is always internally
      consistent with where the files actually are.

      The one thing this cannot do is change allow_unc on a later install,
      because NeverOverwrite skips the file entirely. That is the lesser evil: an
      upgrade must not re-grant an opt-in the operator has since withdrawn by
      hand, and a repair must not undo an operator who has tightened the config.

      The opt-in is therefore not written from here at all. install.ps1 -AllowUNC
      passes ALLOWUNC=1 on the command line so this check agrees, and then edits
      allow_unc in config.yaml after the install, which both survives
      NeverOverwrite and puts the value where a person can read and change it.
    -->
    <Component Id="ConfigFile" Guid="6D9B7FD5-4A82-4EA6-9FB2-7B5C4DAF0C66" Directory="DATAFOLDER">
      <File Id="ConfigFileName"
            Name="config.yaml"
            Source="!(bindpath.res)\config.yaml.template"
            KeyPath="yes">
        <util:ConfigurableTextFile Encoding="UTF-8"
                                   NeverOverwrite="yes"
                                   Configuration="DATADIR=[DATAFOLDER];STATUSFILE=[STATUSFILE];LOGFILE=[LOGFILE];BACKUPPATH=[BACKUPPATH]" />
      </File>
    </Component>

    <!-- ================= properties ================= -->
    <!-- The folder to protect. A deployment is expected to set this; an
         interactive install is now asked for it on the BackupPathDlg page
         below; and a hand-typed /qn install that sets neither falls back to
         this default rather than to a drive root. The default is created if
         absent and refused if it is not on a fixed disk, both by
         validatepath.exe. -->
    <Property Id="BACKUPPATH" Value="C:\SoftafriqueBackup" />

    <!-- Set from the execute sequence rather than through a Value attribute.
         A Property/@Value is a string literal, not a formatted field, so
         Value="[DATAFOLDER]status.json" would put the brackets in the file on
         disk and the agent would create "[DATAFOLDER]status.json" relative to
         its working directory. WiX says as much (WIX1077). SetProperty does
         format, and CostFinalize is the last stop before the config file is
         written, so this has to sit there and no later. -->
    <Property Id="STATUSFILE" Secure="yes" />
    <Property Id="LOGFILE" Secure="yes" />
    <SetProperty Id="STATUSFILE" Value="[DATAFOLDER]status.json"
                 Before="CostFinalize" Sequence="execute" />
    <SetProperty Id="LOGFILE" Value="[DATAFOLDER]agent.log"
                 Before="CostFinalize" Sequence="execute" />

    <!-- The path to a one-time enrollment token written by the RMM. Only the
         path travels through the MSI; the token itself is read and deleted by
         the agent. -->
    <Property Id="ENROLLTOKENFILE" Secure="yes" />

    <!-- Set on the CI smoke-test command line so nothing touches the service or
         the network. -->
    <Property Id="TESTINSTALL" Secure="yes" />

    <!-- Set ALLOWUNC=1 to permit a network share as the folder to protect. A
         network share is refused by default, and this is the only way past it.

         The reason is not that restic cannot read one; it can. The service runs
         as LocalSystem and reaches a share as the machine account, so
         \\FILESERVER\CustomerData can open fine for the technician who typed it
         and then fail every hourly backup because the machine account was never
         granted access, silently, with nothing in status.json to explain it.
         A path that works interactively and dies quietly as a service is worse
         than a refused install, so allowing it is a decision somebody has to
         make on purpose.

         This is a launch-time property, not a dialog control. A property set by
         a control lives in the client-side property table and a deferred custom
         action cannot see it; passing it on the msiexec command line is what
         makes it reach ValidateBackupFolder. A technician who genuinely needs a
         share should install silently with ALLOWUNC=1, which is what
         scripts/rmm/install.ps1 -AllowUNC does.
    -->
    <Property Id="ALLOWUNC" Secure="yes" />

    <!-- Set just before the check, so the flag is present only when it was asked
         for. The space is inside the value so the command line reads correctly
         with the switch absent. -->
    <Property Id="ALLOWUNCSWITCH" Secure="yes" />
    <SetProperty Id="ALLOWUNCSWITCH" Value="-allow-unc "
                 Before="ValidateBackupFolder" Sequence="execute" Condition="ALLOWUNC" />

    <Property Id="VALIDATEFOLDERCMD" Secure="yes" />
    <Property Id="ENROLLCMD" Secure="yes" />
    <Property Id="STARTSERVICECMD" Secure="yes" />

    <SetProperty Id="VALIDATEFOLDERCMD"
                 Value="&quot;[INSTALLFOLDER]validatepath.exe&quot; [ALLOWUNCSWITCH]&quot;[BACKUPPATH]&quot;"
                 Before="ValidateBackupFolder" Sequence="execute" />
    <SetProperty Id="ENROLLCMD"
                 Value="&quot;[INSTALLFOLDER]SoftafriqueBackupAgent.exe&quot; enroll -token-file &quot;[ENROLLTOKENFILE]&quot; -config &quot;[DATAFOLDER]config.yaml&quot;"
                 Before="EnrollDevice" Sequence="execute" />
    <SetProperty Id="STARTSERVICECMD" Value="&quot;[SystemFolder]sc.exe&quot; start &quot;SoftafriqueBackupAgent&quot;"
                 Before="StartEnrolledService" Sequence="execute" />

    <!-- ================= custom actions ================= -->
    <!--
      Both are Type 34/ deferred, run in the SYSTEM context and use
      WixQuietExec, so a return code of 1 fails the install instead of being
      logged and ignored. That matters: an install that "succeeded" while
      enrollment failed would leave a machine that looks deployed and protects
      nothing.
    -->
    <CustomAction Id="ValidateBackupFolder"
                  BinaryRef="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <CustomAction Id="EnrollDevice"
                  BinaryRef="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <!-- Only the token-file path starts the service here. The RMM script starts
         it itself after enrolling, and a hand-typed install with no token
         deliberately leaves it stopped for an operator to enroll first. -->
    <CustomAction Id="StartEnrolledService"
                  BinaryRef="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <InstallExecuteSequence>
      <Custom Action="ValidateBackupFolder" After="InstallFiles"
              Condition="NOT TESTINSTALL AND NOT REMOVE" />

      <!-- Enrollment happens after the service exists and the data directory is
           locked down, and before the service starts, so the very first
           scheduled run already has credentials. InstallServices is skipped on
           this path because the service was never started. -->
      <Custom Action="EnrollDevice" After="ValidateBackupFolder"
              Condition="NOT TESTINSTALL AND NOT REMOVE AND ENROLLTOKENFILE" />

      <Custom Action="StartEnrolledService" After="StartServices"
              Condition="NOT TESTINSTALL AND NOT REMOVE AND ENROLLTOKENFILE" />
    </InstallExecuteSequence>

    <!-- The check runs once, in the execute sequence, for every install mode:
         interactive, quiet and basic MSI alike. Windows Installer runs the UI
         sequence to completion and then runs the execute sequence, so listing
         this action a second time in InstallUISequence would achieve nothing,
         because Windows Installer ignores a deferred action scheduled from a UI
         sequence, and it would look as though the interactive install validated
         something twice.

         What an interactive install does not get is the reason. The check is
         deferred and runs as SYSTEM after the files are laid down, so a refused
         path surfaces as a rollback at the end of the progress bar, with the
         explanation in the MSI log rather than on screen. That is why the
         dialog below says so, and why validatepath.exe is shipped as its own
         component: a technician who wants to test a candidate folder before
         committing to it can run it by hand and read the sentence on stderr. -->

    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- ================= protected folder prompt ================= -->
    <!--
      Asks the technician which folder to protect, defaulting to the value
      BACKUPPATH already carries.

      Why this exists: with no prompt, a hand-typed `msiexec /i` install silently
      protected C:\SoftafriqueBackup, an empty folder created by nobody, which is
      the "quietly backing up nothing" outcome that validatepath.exe was written
      to prevent. The value was right and still wrong, because nobody was shown
      it.

      The RMM path does not come through here at all. install.ps1 takes
      -BackupPath as a mandatory parameter, so PowerShell prompts for it and
      passes it on the msiexec command line as BACKUPPATH, and it installs with
      /qn, which runs no UI sequence. This dialog only ever appears to a human at
      the keyboard running msiexec without /qn.

      Validation is unchanged and does run for every install, prompted or not:
      the ValidateBackupFolder action creates the folder and refuses a
      non-fixed volume, from the execute sequence, which every install mode goes
      through. This dialog only collects the value.

      What the dialog cannot do is report a refusal: the check is deferred, so a
      bad path ends the install with a rollback and the reason in the log. The
      description says so rather than implying an answer arrives on this page,
      and validatepath.exe can be run by hand to test a path first.

      NOT YET VERIFIED: this needs a Windows host to compile and a human to walk
      the UI. See docs/OPERATIONS.md. If the <Publish> below does not take effect
      against WixUI_InstallDir's own sequence, the failure mode is that no prompt
      appears and the install behaves exactly as 0.2.0 did, not a broken install.
    -->
    <UI>
      <Dialog Id="BackupPathDlg" Width="370" Height="270" Title="Folder to protect">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15"
                 Transparent="no" NoPrefix="yes" Text="{\WixUI_Font_Title}Folder to protect" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="324" Height="39"
                 Transparent="no" NoPrefix="yes"
                 Text="Enter the customer folder to protect. It is created if it does not exist, and it must be on a fixed disk." />
        <Control Id="FolderLabel" Type="Text" X="25" Y="75" Width="90" Height="15"
                 Transparent="no" NoPrefix="yes" Text="Folder" />
        <Control Id="BackupPathEdit" Property="BACKUPPATH" Type="PathEdit"
                 X="120" Y="73" Width="229" Height="17" Indirect="no" />
        <Control Id="Warning" Type="Text" X="25" Y="100" Width="324" Height="45"
                 Transparent="no" NoPrefix="yes"
                 Text="An optical or removable drive will be refused, and so will a network share: the service runs as LocalSystem and may not be able to reach it. If the install rolls back, the reason is in the MSI log, or run validatepath.exe in the install folder to test this path first." />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="Next">
          <Publish Event="NewDialog" Value="CostFinalize" />
        </Control>
      </Dialog>

      <!-- Take over the Next button on the install-location page so the folder
           page follows it. CostFinalize is where WixUI_InstallDir would have
           gone next, so nothing downstream of the sequence is lost. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="BackupPathDlg" />
    </UI>
  </Package>
</Wix>
